EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# aia-call-intelligence-service base URL.
# - iOS/Android simulator on the same machine: http://localhost:4001 works.
# - Expo Go on a physical phone: use your computer's LAN IP instead of
#   localhost (the phone can't resolve "localhost" to your laptop) --
#   find it with `ipconfig` (Windows) / `ifconfig` (Mac/Linux), look for the
#   Wi-Fi adapter's IPv4 address, e.g. http://192.168.1.23:4001.
#   Phone and laptop must be on the same Wi-Fi network.
EXPO_PUBLIC_NOTIFICATIONS_URL=http://localhost:4001
