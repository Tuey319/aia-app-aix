{
  "name": "aia-call-intelligence-service",
  "version": "0.1.0",
  "description": "Prototype backend serving the AIA+ proactive call-intent notification feed to the app.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "reset-data": "node -e \"require('fs').copyFileSync('data/notifications.seed.json','data/notifications.json')\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
